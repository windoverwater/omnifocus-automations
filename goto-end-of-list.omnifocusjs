/*{
	"type": "action",
	"targets": ["omnifocus"],
	"author": "Sandy Currier",
	"identifier": "com.omni-automation.of.goto-end-of-list",
	"version": "1.0",
	"description": "Goto the last itme in the current list of items",
	"label": "Goto End of List",
	"shortLabel": "Goto EOL"
}*/
(() => {
  const action = new PlugIn.Action(async function(selection) {

    console.log("=== EOL Tagger: starting ===");

    try {
      // Find or create the EOL tag
      const matches = flattenedTags.filter(t => t.name === "EOL");
      let eolTag = matches.length > 0 ? matches[0] : new Tag("EOL");
      console.log("eolTag:", eolTag.name);

      const win = document.windows[0];
      const tree = win.content;

      // Walk the entire visible content tree, collecting Task nodes in display order
      const taskNodes = [];
      tree.rootNode.apply(node => {
        if (node.object instanceof Task) {
          taskNodes.push(node);
        }
      });

      console.log("Visible task nodes found:", taskNodes.length);

      if (taskNodes.length === 0) {
        new Alert("EOL Tagger", "No tasks found in current view.").show();
        return;
      }

      console.log("First task:", taskNodes[0].object.name);
      console.log("Last task:", taskNodes[taskNodes.length - 1].object.name);

      // Remove EOL tag from any previously tagged task
      const previousEOL = eolTag.tasks;
      console.log("Previously tagged:", previousEOL.length);
      previousEOL.forEach(task => task.removeTag(eolTag));

      // Tag the last visible task
      const lastNode = taskNodes[taskNodes.length - 1];
      const lastTask = lastNode.object;
      console.log("Tagging:", lastTask.name);
      lastTask.addTag(eolTag);

      // Reveal (scroll to) and select it
      tree.select([]);
      tree.select([lastNode], true);
      tree.reveal([lastNode]);

      console.log("=== EOL Tagger: done ===");

    } catch (err) {
      console.log("CAUGHT ERROR:", err);
      console.log("ERROR MESSAGE:", err.message);
      new Alert("EOL Tagger Error", String(err)).show();
    }

  });

  action.validate = function(selection) {
    return true;
  };

  return action;
})();
